# =============================================================================
# OpenClaw Railway Template - Environment Variables
# =============================================================================
# Copy this file to .env for local development
# For Railway deployment, set these in the Railway dashboard Variables section
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES
# -----------------------------------------------------------------------------

# Password to access the /setup wizard
# For Railway: Use ${{ secret() }} to generate a random secure password
# For local: Set any password you want
SETUP_PASSWORD=your-secure-password-here

# Directory where openclaw stores configuration and state
# MUST point to /data on Railway (volume mount) for persistence
OPENCLAW_STATE_DIR=/data/.openclaw

# Directory where openclaw stores workspace files
# MUST point to /data on Railway (volume mount) for persistence
OPENCLAW_WORKSPACE_DIR=/data/workspace

# -----------------------------------------------------------------------------
# RECOMMENDED VARIABLES
# -----------------------------------------------------------------------------

# Authentication token for the openclaw gateway and Control UI
# For Railway: Use ${{ secret() }} to generate a stable secret
# For local: Generate with: openssl rand -hex 32
# If not set, the wrapper will generate one (not ideal for production)
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL VARIABLES (Usually don't need to change)
# -----------------------------------------------------------------------------

# Port the wrapper server listens on
# Railway sets this automatically, usually to 8080
PORT=8080

# Internal port where the gateway listens (proxied by the wrapper)
# Default: 18789
INTERNAL_GATEWAY_PORT=18789

# Internal host for the gateway
# Default: 127.0.0.1
INTERNAL_GATEWAY_HOST=127.0.0.1

# Path to the openclaw configuration file
# Default: ${OPENCLAW_STATE_DIR}/openclaw.json
# Leave empty to use the default
OPENCLAW_CONFIG_PATH=

# Path to the openclaw CLI entry point
# Default: /usr/local/lib/node_modules/openclaw/dist/entry.js
# Leave empty unless using a custom build
OPENCLAW_ENTRY=/usr/local/lib/node_modules/openclaw/dist/entry.js

# Node.js executable to use
# Default: node
# Leave empty unless you need a specific node binary
OPENCLAW_NODE=node

# -----------------------------------------------------------------------------
# AGENT PERSONA & DEFAULTS (src/agent-persona.js) - all optional
# -----------------------------------------------------------------------------
# SOUL/IDENTITY/USER/AGENTS.md are seeded into the workspace only when missing; your edits are never overwritten.
# Set to 0 to disable seeding.
# OPENCLAW_PERSONA_SEED=1
# Default model, format <provider>/<model> (applied to agents.defaults.model.primary at gateway start).
# OPENCLAW_DEFAULT_MODEL=anthropic/claude-sonnet-5-5
# Default thinking level (agents.defaults.thinkingDefault), e.g. off, low, medium, high.
# OPENCLAW_THINKING_DEFAULT=low
# Agent browser tool: set to 1 to enable the managed headless Chromium (browser.enabled/headless/noSandbox/
# defaultProfile/executablePath). The image already ships chromium at /usr/bin/chromium.
# OPENCLAW_BROWSER=1
# OPENCLAW_BROWSER_EXECUTABLE=/usr/bin/chromium
# Cloud browser over CDP (Browserless / Browserbase). wss:// or https:// URL including the provider token.
# Creates profile "cloud" and makes it the default. Set the value in Railway only; never commit it.
# OPENCLAW_CLOUD_BROWSER_CDP_URL=

# -----------------------------------------------------------------------------
# BASHT x DAFTRA SKILL (skills/basht-daftra) - values are set in Railway, never committed
# -----------------------------------------------------------------------------
# Tenant root, HTTPS *.daftra.com only. Required for the skill to be eligible.
# DAFTRA_BASE_URL=https://your-tenant.daftra.com
# API key from Daftra Settings > API. Restrict its roles to the entities needed.
# DAFTRA_API_KEY=
# Financial writes are OFF unless this is exactly 1. Enable only for supervised sessions.
# DAFTRA_WRITES_ENABLED=
# Operator-only secret (>=32 random chars, e.g. `openssl rand -hex 32`). Authenticates proposals, the ledger
# and per-proposal approval codes. Required for any financial operation. Never share it with the agent.
# DAFTRA_APPROVAL_SECRET=
# Max approved writes per rolling hour (default 20)
# DAFTRA_MAX_WRITES_PER_HOUR=20
# Chromium for generated PDF summaries (default: auto-detect)
# CHROMIUM_PATH=

# -----------------------------------------------------------------------------
# STORAGE DIAGNOSTICS (src/storage-diagnostics.js) - optional, OFF by default, read-only
# -----------------------------------------------------------------------------
# Set to 1 to log two compact JSON "[storage-diag]" lines at boot+90s and every N hours: volume usage (statfs),
# sizes/counts per top folders, measured cleanup candidates. Never reads file contents, never deletes, never
# prints protected names (memory, sessions, WhatsApp/auth, credentials, databases, backups). OpenClaw doctor snapshots
# and tmp/plugin-captures are measured in a separate "recovery" bucket and are never cleanup candidates.
# Any value other than exactly 1 (including 0) disables it.
# DIAG_STORAGE=1
# DIAG_STORAGE_ROOT=/data
# DIAG_STORAGE_INTERVAL_HOURS=6
# Delay of the first scan after boot, integer seconds 5..3600 (default 90). Only for tests/slow starts.
# DIAG_STORAGE_FIRST_DELAY_SEC=90
# DIAG_STORAGE_ROOT may point at any directory; if it is (inside) a protected tree such as <workspace>/memory the
# whole scan is reported as one anonymous protected total and the configured path is never printed.

# -----------------------------------------------------------------------------
# RAILWAY-SPECIFIC VARIABLES (Set automatically by Railway)
# -----------------------------------------------------------------------------

# Git commit SHA - automatically set by Railway during deployment
# Do not set manually
# RAILWAY_GIT_COMMIT_SHA=

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 1. For Railway deployment, you MUST have a Volume mounted at /data
# 2. Without the volume, configuration will be lost on every redeploy
# 3. After deployment, visit https://your-app.up.railway.app/setup to configure
# 4. The setup wizard will guide you through onboarding
# =============================================================================
